# Mapbox (required for map)
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# TransitMatters API (archived headways and delays)
# Get key from TransitMatters; use in .env.local (do not commit real key)
TRANSITMATTERS_API_KEY=
TRANSITMATTERS_BASE_URL=https://dashboard.transitmatters.org

# MBTA archived last-week metrics (optional fallback via API endpoint)
# TODO: Fill in exact MBTA archive endpoint when dataset/query is known
# If left blank AND TRANSITMATTERS_API_KEY is not set, the CSV provider is used instead.
MBTA_ARCHIVE_BASE_URL=
MBTA_ARCHIVE_DATASET=

# MBTA Bus Arrival/Departure CSV (local file, used as fallback archived provider + /route-trip-charts)
# Place CSV files in data/mbta-bus/ relative to project root, or set an explicit path:
# MBTA_BUS_ARRIVAL_CSV=/absolute/or/relative/path/to/MBTA-Bus-Arrival-Departure-Times_2026-01.csv
# MBTA_BUS_ARRIVAL_MONTH=2026-01  # used with default data/mbta-bus/MBTA-Bus-Arrival-Departure-Times_{MONTH}.csv
# Default filename if unset: MBTA-Bus-Arrival-Departure-Times_2026-01.csv

# MBTA bus ridership by trip / stop (optional; map scorecard “Trip load” panel)
# MBTA_BUS_RIDERSHIP_CSV=/path/to/MBTA_Bus_Ridership_by_Trip_Season_Route_Line_and_Stop_Spring_2024.csv
# MBTA_BUS_RIDERSHIP_FILE=MBTA_Bus_Ridership_by_Trip_Season_Route_Line_and_Stop_Spring_2024.csv

# Swiftly real-time
# TODO: Fill in Swiftly agency and endpoint paths when known
SWIFTLY_API_KEY=
SWIFTLY_BASE_URL=
SWIFTLY_AGENCY_ID=

# Optional: enable debug logs
DEBUG=
